        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"claude-3-5-sonnet-latest\", max_tokens: 200, messages: [{ role: \"user\", content: \"Summarize this industrial/IoT alarm in one sentence, then give the single most likely cause and a priority (low/medium/high). Do NOT decide whether to suppress it or who to notify — deterministic rules handle that. Alarm: \" + JSON.stringify($json) }] }) }}",
        "options": {}
