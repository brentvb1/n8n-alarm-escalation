    {
      "parameters": {
        "jsCode": "// Normalize an incoming SCADA/IoT alarm into a standard shape.\n// Expected POST body (flexible): { source, alarmId, severity, message, timestamp }\n// n8n wraps a webhook POST body under $json.body.\nconst b = $json.body || $json;\nconst alarm = {\n  source: b.source || 'unknown-source',\n  alarmId: b.alarmId || b.id || 'unknown-id',\n  severity: String(b.severity || 'info').toLowerCase(),\n  message: b.message || b.text || '',\n  timestamp: b.timestamp || new Date().toISOString(),\n};\n// Stable dedup key: one alarm from one source.\nalarm.dedupKey = alarm.source + '::' + alarm.alarmId;\nreturn [{ json: alarm }];\n"
      },
      "id": "c6d2c21a-7a28-4027-a88c-e35dbe65e751",
      "name": "Normalize Alarm",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        8544,
        2368
      ]
    },
    {
      "parameters": {
        "jsCode": "// FLOOD / CHATTER SUPPRESSION.\n// Industrial alarms can re-fire many times a minute (a flapping sensor).\n// Without this, every repeat would wake someone. We remember each\n// dedupKey's last-seen time in workflow static data and suppress repeats\n// inside a window. This is the piece a generic 'send an alert' flow skips.\nconst WINDOW_MS = 5 * 60 * 1000; // 5 minutes — tune to your environment\nconst a = $json;\nconst store = $getWorkflowStaticData('global');\nstore.seen = store.seen || {};\nconst now = Date.now();\n// prune old entries so static data does not grow unbounded\nfor (const k of Object.keys(store.seen)) {\n  if (now - store.seen[k] > WINDOW_MS) delete store.seen[k];\n}\nconst last = store.seen[a.dedupKey];\nconst suppressed = last != null && (now - last) < WINDOW_MS;\nif (!suppressed) store.seen[a.dedupKey] = now;\nreturn [{ json: { ...a, suppressed } }];\n"
      },
      "id": "24bde0c0-cd72-4f0d-a96f-80402025079e",
      "name": "Flood Suppression",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        8768,
        2368
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "if-sup-c",
              "leftValue": "={{ $json.suppressed }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "47f9d327-8d88-45bc-9bb6-31cb44e42761",
      "name": "Suppressed?",
