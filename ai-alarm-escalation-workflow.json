{
  "name": "AI Alarm Escalation (ACK + timeout tiers)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "alarm-in",
        "options": {}
      },
      "id": "webhook-in",
      "name": "Alarm Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        400
      ],
      "webhookId": "alarm-in-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Normalize an incoming SCADA/IoT alarm into a standard shape.\n// Expected POST body (flexible): { source, alarmId, severity, message, timestamp }\n// n8n wraps a webhook POST body under $json.body.\nconst b = $json.body || $json;\nconst alarm = {\n  source: b.source || 'unknown-source',\n  alarmId: b.alarmId || b.id || 'unknown-id',\n  severity: String(b.severity || 'info').toLowerCase(),\n  message: b.message || b.text || '',\n  timestamp: b.timestamp || new Date().toISOString(),\n};\n// Stable dedup key: one alarm from one source.\nalarm.dedupKey = alarm.source + '::' + alarm.alarmId;\nreturn [{ json: alarm }];\n"
      },
      "id": "c-normalize",
      "name": "Normalize Alarm",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// FLOOD / CHATTER SUPPRESSION.\n// Industrial alarms can re-fire many times a minute (a flapping sensor).\n// Without this, every repeat would wake someone. We remember each\n// dedupKey's last-seen time in workflow static data and suppress repeats\n// inside a window. This is the piece a generic 'send an alert' flow skips.\nconst WINDOW_MS = 5 * 60 * 1000; // 5 minutes \u2014 tune to your environment\nconst a = $json;\nconst store = $getWorkflowStaticData('global');\nstore.seen = store.seen || {};\nconst now = Date.now();\n// prune old entries so static data does not grow unbounded\nfor (const k of Object.keys(store.seen)) {\n  if (now - store.seen[k] > WINDOW_MS) delete store.seen[k];\n}\nconst last = store.seen[a.dedupKey];\nconst suppressed = last != null && (now - last) < WINDOW_MS;\nif (!suppressed) store.seen[a.dedupKey] = now;\nreturn [{ json: { ...a, suppressed } }];\n"
      },
      "id": "c-flood",
      "name": "Flood Suppression",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        560
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "if-sup-c",
              "leftValue": "={{ $json.suppressed }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-sup",
      "name": "Suppressed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        680,
        560
      ]
    },
    {
      "parameters": {
        "jsCode": "// Audit record: alarm suppressed as a duplicate within the window.\n// Wire this to your log destination (Google Sheets / database).\nreturn [{ json: { audit: 'suppressed', ...$json, loggedAt: new Date().toISOString() } }];\n"
      },
      "id": "log-sup",
      "name": "Log: Suppressed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        680
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"claude-3-5-sonnet-latest\", max_tokens: 200, messages: [{ role: \"user\", content: \"Summarize this industrial/IoT alarm in one sentence, then give the single most likely cause and a priority (low/medium/high). Do NOT decide whether to suppress it or who to notify \u2014 deterministic rules handle that. Alarm: \" + JSON.stringify($json) }] }) }}",
        "options": {}
      },
      "id": "http-triage",
      "name": "Claude Triage (advisory)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        400
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Re-attach the alarm fields to the (advisory) triage result.\n// The HTTP node's output is the API response, so we pull the original\n// alarm from the upstream node and add the triage text if we got any.\n// Because the triage step is non-blocking, triage may be empty here \u2014\n// that is fine, escalation proceeds regardless.\nconst alarm = $('Flood Suppression').item.json;\nlet triage = '';\ntry { triage = $json.content?.[0]?.text || ''; } catch (e) { triage = ''; }\nreturn [{ json: { ...alarm, triage } }];\n"
      },
      "id": "c-attach",
      "name": "Attach Triage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        400
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r-crit",
                    "leftValue": "={{ $json.severity }}",
                    "rightValue": "critical",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "critical"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r-warn",
                    "leftValue": "={{ $json.severity }}",
                    "rightValue": "warning",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "warning"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "severity-switch",
      "name": "Severity Route",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        1120,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://REPLACE-WITH-YOUR-NOTIFICATION-ENDPOINT.example.com/send",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: \"on-call-tier-1\", severity: $json.severity, summary: ($json.triage || $json.message), source: $json.source, alarmId: $json.alarmId, ackUrl: $execution.resumeUrl }) }}",
        "options": {}
      },
      "id": "n-t1",
      "name": "Notify Tier 1 (On-Call)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        240
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "resume": "webhook",
        "options": {
          "limitWaitTime": true,
          "limitType": "afterTimeInterval",
          "resumeAmount": 5,
          "resumeUnit": "minutes"
        }
      },
      "id": "wait-1",
      "name": "Wait for ACK (Tier 1)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1560,
        240
      ],
      "webhookId": "wait-ack-1"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "if-t1-c",
              "leftValue": "={{ $json.ack === true || ($json.body && $json.body.ack === true) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-t1",
      "name": "ACK received? (T1)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1780,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const alarm = $('Attach Triage').item.json;\nreturn [{ json: { audit: 'acknowledged', tier: 1, ...alarm, acknowledgedAt: new Date().toISOString() } }];\n"
      },
      "id": "log-ack1",
      "name": "Log: Acknowledged (T1)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        160
