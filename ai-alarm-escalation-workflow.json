    {
      "parameters": {
        "jsCode": "// Re-attach the alarm fields to the (advisory) triage result.\n// The HTTP node's output is the API response, so we pull the original\n// alarm from the upstream node and add the triage text if we got any.\n// Because the triage step is non-blocking, triage may be empty here —\n// that is fine, escalation proceeds regardless.\nconst alarm = $('Flood Suppression').item.json;\nlet triage = '';\ntry { triage = $json.content?.[0]?.text || ''; } catch (e) { triage = ''; }\nreturn [{ json: { ...alarm, triage } }];\n"
      },
